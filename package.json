{
  "name": "aster-browser",
  "productName": "Aster",
  "version": "0.5.0",
  "description": "A Chromium browser with workspaces, Mission Control, and native media controls.",
  "main": "src/main/index.cjs",
  "private": true,
  "license": "MIT",
  "author": "Manav Harsora",
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "app-builder-bin": true,
    "@parcel/watcher": true
  },
  "scripts": {
    "setup": "node node_modules/electron/install.js",
    "start": "electron .",
    "start:automation": "node scripts/start-automation.cjs",
    "test": "node --test test/*.test.cjs",
    "test:integration": "node scripts/integration.cjs",
    "test:backend": "node scripts/backend-regression.cjs",
    "test:ui": "node scripts/ui-regression.cjs",
    "test:media": "node scripts/media-regression.cjs",
    "test:shields": "node scripts/shields-regression.cjs",
    "build:filters": "node scripts/build-filters.cjs",
    "build": "electron-builder --mac dir --arm64",
    "mcp": "node bin/aster-mcp.cjs",
    "cli": "node bin/aster.cjs",
    "test:agents": "node scripts/agent-regression.cjs",
    "test:search-motion": "node scripts/search-motion-regression.cjs",
    "test:gestures": "node scripts/gestures-regression.cjs",
    "build:glass": "node scripts/build-glass.cjs",
    "test:session": "node scripts/session-regression.cjs",
    "test:media-controls": "node scripts/media-controls-regression.cjs",
    "test:performance": "node scripts/agent-benchmark.cjs",
    "build:media-preload": "node scripts/build-media-preload.cjs",
    "test:polish": "node scripts/ui-polish-regression.cjs",
    "test:appearance": "node scripts/appearance-regression.cjs",
    "test:agent-zoom": "node scripts/agent-zoom-regression.cjs",
    "test:lifecycle": "node scripts/lifecycle-regression.cjs",
    "test:accessibility": "node scripts/renderer-accessibility-regression.cjs",
    "test:client-timeout": "node scripts/client-timeout-regression.cjs",
    "test:navigation": "node scripts/navigation-regression.cjs",
    "build:gesture-phases": "node scripts/build-gesture-phases.cjs",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "tldts-experimental": "7.4.19"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1",
    "pngjs": "7.0.0"
  },
  "build": {
    "appId": "dev.aster.browser",
    "productName": "Aster",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "bin/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "bin",
        "to": "automation",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "LICENSE",
        "to": "licenses/Aster-MIT.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/Aster-THIRD_PARTY_NOTICES.md"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "identity": "-",
      "icon": "assets/icon.icns",
      "extendInfo": {
        "NSCameraUsageDescription": "A website can use the camera only after you allow it.",
        "NSMicrophoneUsageDescription": "A website can use the microphone only after you allow it.",
        "NSHighResolutionCapable": true
      },
      "hardenedRuntime": false,
      "notarize": false,
      "minimumSystemVersion": "13.0"
    },
    "asarUnpack": [
      "src/native/*.node"
    ],
    "dmg": {
      "artifactName": "Aster-${version}-mac-${arch}.${ext}",
      "writeUpdateInfo": false,
      "title": "Aster ${version}"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis",
      "artifactName": "Aster-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "differentialPackage": false
    }
  }
}
